# Copy to .env.local (git-ignored) to override. Both are optional — the defaults
# work against an API running locally on its documented port.

# Absolute base URL for the Rekfar API, bypassing the /api proxy. Include the
# version. Reaching the API cross-origin this way means its Cors:AllowedOrigins
# must name this site.
# VITE_API_BASE_URL=https://rekfar-api.salmonocean-b5a2e037.swedencentral.azurecontainerapps.io/v1

# Where the dev server forwards /api. Defaults to the API's own launch profile.
# VITE_DEV_API_TARGET=http://localhost:5199
